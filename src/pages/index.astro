---
import { url } from '../utils/url';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import heroImage from '../assets/projects/tengah-pavilion-steel-frame.jpg';
import { company, formatSGD, portfolioSummary } from '../data/company';
import { capabilities } from '../data/capabilities';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
	title={company.legalName}
	description="GOOD WAVE E&C PTE. LTD. is a Singapore-registered building construction contractor delivering structural steel, railings and barriers, temporary works and associated site works within residential and infrastructure developments."
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">Singapore-registered building construction contractor</p>
				<h1 id="hero-title">Engineering, Construction &amp; Steel Works</h1>
				<p class="lead">
					Specialist construction packages across structural steel installation, railings and barriers,
					temporary works and associated site works, delivered within residential, public-housing and
					infrastructure developments.
				</p>
				<div class="btn-row">
					<a class="btn btn--primary" href={url('/projects/')}>
						Explore Our Projects
						<Icon name="arrow-right" size={18} />
					</a>
					<a class="btn btn--secondary" href={url('/contact/')}>Contact Us</a>
				</div>
			</div>
			<figure class="hero-media">
				<Image
					src={heroImage}
					alt="Steel-framed pavilion structure on the Tengah PA C1 & CG site, with residential blocks behind."
					widths={[480, 720, heroImage.width]}
					sizes="(min-width: 1024px) 560px, 100vw"
					loading="eager"
					fetchpriority="high"
				/>
				<figcaption>Pavilion steelwork, Tengah PA C1 &amp; CG</figcaption>
			</figure>
		</div>
	</section>

	<section class="stats" aria-labelledby="stats-title">
		<div class="container">
			<h2 id="stats-title" class="visually-hidden">Portfolio at a glance</h2>
			<dl class="stats-grid">
				<div>
					<dt>Selected projects</dt>
					<dd class="num">{portfolioSummary.projectCount}</dd>
				</div>
				<div>
					<dt>Combined stated value of selected projects</dt>
					<dd class="num">{formatSGD(portfolioSummary.combinedStatedValue)}</dd>
				</div>
				<div>
					<dt>Project periods</dt>
					<dd class="num">{portfolioSummary.periodSpan}</dd>
				</div>
				<div>
					<dt>Steel structure installation, Tengah PA C1 &amp; CG</dt>
					<dd class="num">~700 t</dd>
				</div>
			</dl>
			<p class="stats-note">
				The combined value is the sum of the three stated project values (S$560,000 + S$140,000 +
				S$1,450,682). It is a portfolio summary, not company turnover.
			</p>
		</div>
	</section>

	<section class="section" aria-labelledby="capabilities-title">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Capabilities</p>
					<h2 id="capabilities-title">Focused execution across steel and construction packages</h2>
				</div>
				<a class="text-link" href={url('/capabilities/')}>All capabilities <Icon name="arrow-right" size={18} /></a>
			</div>
			<ol class="cap-grid">
				{
					capabilities.map((cap) => (
						<li>
							<span class="cap-num" aria-hidden="true">{cap.number}</span>
							<h3>{cap.title}</h3>
							<p>{cap.summary}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section section--surface" aria-labelledby="projects-title">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Selected projects</p>
					<h2 id="projects-title">Documented project experience</h2>
				</div>
				<a class="text-link" href={url('/projects/')}>All projects <Icon name="arrow-right" size={18} /></a>
			</div>
			<div class="project-grid">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="about-title">
		<div class="container about-grid">
			<div>
				<p class="eyebrow">About the company</p>
				<h2 id="about-title">Building with precision. Delivering with discipline.</h2>
				<p>
					{company.legalName} is a Singapore Private Company Limited by Shares, incorporated on
					{' '}{company.incorporated}. It operates in the general contracting sector and focuses on
					delivering defined work packages within major residential, public-housing and infrastructure
					developments.
				</p>
				<a class="text-link" href={url('/about/')}>Company profile <Icon name="arrow-right" size={18} /></a>
			</div>
			<dl class="facts">
				<div><dt>UEN</dt><dd>{company.uen}</dd></div>
				<div><dt>Incorporated</dt><dd>{company.incorporated}</dd></div>
				<div><dt>Business activity</dt><dd>{company.businessActivity}</dd></div>
				<div><dt>Registered office</dt><dd>{company.address.street}, Singapore {company.address.postalCode}</dd></div>
			</dl>
		</div>
	</section>

	<ContactCTA />
</BaseLayout>

<style>
	.hero {
		padding-block: var(--space-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-grid {
		display: grid;
		gap: var(--space-2xl);
		align-items: center;
	}

	@media (min-width: 1024px) {
		.hero {
			padding-block: var(--space-3xl);
		}

		.hero-grid {
			grid-template-columns: 1fr minmax(0, 560px);
			gap: var(--space-3xl);
		}
	}

	.hero-copy .lead {
		max-width: 56ch;
		margin-bottom: var(--space-xl);
	}

	.hero-media {
		margin: 0;
	}

	.hero-media img {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		border-radius: var(--radius-md);
		border-bottom: 4px solid var(--color-ochre);
	}

	figcaption {
		margin-top: var(--space-sm);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.stats {
		background: var(--color-surface);
		padding-block: var(--space-xl);
		border-bottom: 1px solid var(--color-border);
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		gap: var(--space-lg);
		margin: 0;
	}

	.stats-grid > div {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		gap: var(--space-xs);
		padding-left: var(--space-md);
		border-left: 3px solid var(--color-brand);
	}

	.stats-grid dd {
		margin: 0;
		font-family: var(--font-heading-stack);
		font-size: var(--text-2xl);
		font-weight: 700;
		color: var(--color-brand);
		line-height: 1.2;
	}

	.stats-grid dt {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.stats-note {
		margin: var(--space-lg) 0 0;
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		max-width: 80ch;
	}

	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-md);
		margin-bottom: var(--space-xl);
	}

	.section-head h2 {
		margin-bottom: 0;
		max-width: 28ch;
	}

	.cap-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		border-top: 1px solid var(--color-border);
	}

	.cap-grid li {
		padding: var(--space-lg) var(--space-lg) var(--space-lg) 0;
		border-bottom: 1px solid var(--color-border);
	}

	@media (min-width: 1024px) {
		.cap-grid li {
			padding: var(--space-xl) var(--space-lg);
			border-bottom: 0;
			border-left: 1px solid var(--color-border);
		}

		.cap-grid li:first-child {
			border-left: 0;
			padding-left: 0;
		}
	}

	.cap-num {
		display: block;
		font-family: var(--font-heading-stack);
		font-weight: 700;
		color: var(--color-teal);
		margin-bottom: var(--space-sm);
	}

	.cap-grid h3 {
		margin-bottom: var(--space-sm);
	}

	.cap-grid p {
		margin: 0;
		color: var(--color-text-muted);
	}

	.about-grid {
		display: grid;
		gap: var(--space-2xl);
	}

	@media (min-width: 1024px) {
		.about-grid {
			grid-template-columns: 1fr 1fr;
			align-items: start;
		}
	}
</style>
