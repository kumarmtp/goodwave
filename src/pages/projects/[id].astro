---
import { url } from '../../utils/url';
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Icon from '../../components/Icon.astro';
import { formatSGD } from '../../data/company';
import { capabilities } from '../../data/capabilities';

export const getStaticPaths = (async () => {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { id: project.id },
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}) satisfies GetStaticPaths;

interface Props {
	project: CollectionEntry<'projects'>;
	next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const related = capabilities.filter((cap) => data.capabilities.includes(cap.id));
---

<BaseLayout title={data.title} description={`${data.title} (${data.client}): ${data.summary}`}>
	<PageHeader eyebrow={data.sector} title={data.title}>
		<a slot="before" class="back text-link" href={url('/projects/')}>
			<Icon name="arrow-left" size={18} /> All projects
		</a>
		<p class="client">
			<span class="muted">Client / reference:</span>{' '}{data.client}
		</p>
	</PageHeader>

	<section class="section" aria-labelledby="overview-title">
		<div class="container detail-grid">
			<div class="detail-main">
				<h2 id="overview-title">Project overview</h2>
				<p>{data.overview}</p>
				<Content />

				<h2>Key scope</h2>
				<ul class="scope">
					{data.scope.map((item) => <li>{item}</li>)}
				</ul>

				{
					data.developmentFacts.length > 0 && (
						<>
							<h3>Development information</h3>
							<ul>
								{data.developmentFacts.map((fact) => <li>{fact}</li>)}
							</ul>
						</>
					)
				}
			</div>

			<aside class="detail-aside" aria-labelledby="facts-title">
				<h2 id="facts-title" class="aside-title">Project information</h2>
				<dl class="facts">
					<div><dt>Client</dt><dd>{data.client}</dd></div>
					{data.location && <div><dt>Location</dt><dd>{data.location}</dd></div>}
					<div><dt>Estimated period</dt><dd>{data.period}</dd></div>
					<div><dt>Estimated value</dt><dd>{formatSGD(data.estimatedValue)}</dd></div>
					<div><dt>{data.keyMetric.label}</dt><dd>{data.keyMetric.value}</dd></div>
				</dl>
				<p class="note">
					Period and value as stated in the company portfolio ({data.sourcePages}). They do not indicate
					completion status.
				</p>
			</aside>
		</div>
	</section>

	<section class="section section--surface" aria-labelledby="gallery-title">
		<div class="container">
			<h2 id="gallery-title">Site photography</h2>
			<div class="gallery">
				{
					data.images.map((img) => (
						<figure>
							<Image
								src={img.src}
								alt={img.alt}
								widths={[480, 720, img.src.width]}
								sizes="(min-width: 1024px) 580px, (min-width: 768px) 50vw, 100vw"
							/>
							<figcaption>{img.caption}</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="related-title">
		<div class="container">
			<h2 id="related-title">Related capabilities</h2>
			<ul class="related">
				{
					related.map((cap) => (
						<li>
							<a href={url(`/capabilities/#${cap.id}`)}>
								<span class="cap-title">{cap.title}</span>
								<span class="cap-summary">{cap.summary}</span>
							</a>
						</li>
					))
				}
			</ul>
			<nav class="pager" aria-label="Project navigation">
				<a class="text-link" href={url('/projects/')}><Icon name="arrow-left" size={18} /> Back to projects</a>
				<a class="text-link" href={url(`/projects/${next.id}/`)}>
					Next project: {next.data.shortTitle} <Icon name="arrow-right" size={18} />
				</a>
			</nav>
		</div>
	</section>

	<ContactCTA />
</BaseLayout>

<style>
	.back {
		display: flex;
		width: fit-content;
		margin-bottom: var(--space-md);
	}

	.client {
		font-size: var(--text-lg);
		margin: 0;
	}

	.detail-grid {
		display: grid;
		gap: var(--space-2xl);
	}

	@media (min-width: 1024px) {
		.detail-grid {
			grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
			gap: var(--space-3xl);
			align-items: start;
		}

		.detail-aside {
			position: sticky;
			top: calc(var(--header-height) + var(--space-lg));
		}
	}

	.detail-main {
		max-width: 68ch;
	}

	.detail-main h2:not(:first-child) {
		margin-top: var(--space-xl);
	}

	.scope li {
		margin-bottom: var(--space-sm);
	}

	.detail-aside {
		border-top: 4px solid var(--color-brand);
		padding-top: var(--space-lg);
	}

	.aside-title {
		font-size: var(--text-xl);
	}

	.detail-aside .facts > div {
		grid-template-columns: 1fr;
		gap: var(--space-xs);
	}

	.detail-aside dd {
		font-family: var(--font-heading-stack);
		font-weight: 600;
		color: var(--color-brand);
	}

	.gallery {
		display: grid;
		gap: var(--space-lg);
	}

	@media (min-width: 768px) {
		.gallery {
			grid-template-columns: 1fr 1fr;
		}
	}

	.gallery figure {
		margin: 0;
	}

	.gallery img {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		border-radius: var(--radius-md);
		background: var(--color-tint);
	}

	.gallery figcaption {
		margin-top: var(--space-sm);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.related {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--space-md);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
	}

	.related a {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		height: 100%;
		padding: var(--space-lg);
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-teal);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition:
			border-color var(--duration) ease-out,
			background-color var(--duration) ease-out;
	}

	.related a:hover {
		background: var(--color-surface);
		border-color: var(--color-brand);
	}

	.cap-title {
		font-family: var(--font-heading-stack);
		font-weight: 600;
		font-size: var(--text-lg);
	}

	.cap-summary {
		color: var(--color-text-muted);
	}

	.pager {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-md);
		margin-top: var(--space-2xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}
</style>
