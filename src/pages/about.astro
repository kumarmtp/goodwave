---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import lockup from '../assets/brand/good-wave-logo-lockup.png';
import { company, fullAddress } from '../data/company';
---

<BaseLayout
	title="About"
	description="Company profile of GOOD WAVE E&C PTE. LTD., a Singapore-registered building construction contractor incorporated on 22 April 2021 (UEN 202114466R)."
>
	<PageHeader eyebrow="About the company" title={company.legalName} intro={`${company.description}.`} />

	<section class="section" aria-labelledby="profile-title">
		<div class="container profile-grid">
			<div class="measure">
				<h2 id="profile-title">Company profile</h2>
				<p>
					{company.legalName} is a Singapore Private Company Limited by Shares incorporated on
					{' '}{company.incorporated}. The company is registered with the Accounting and Corporate Regulatory
					Authority (ACRA) under UEN {company.uen} and is recorded in its portfolio as a Live Company.
				</p>
				<p>
					The company operates in the general contracting sector, with its principal and secondary business
					activities recorded as General Contractors (Building Construction including Major Upgrading
					Works). Its documented project portfolio demonstrates involvement in specialist construction
					packages including structural steel installation, temporary works, steel drain works, railings,
					crash barriers, linkways, pavilions and drop-off porch works.
				</p>
				<p>
					The company was previously named {company.previousName}. With a paid-up capital of
					{' '}{company.paidUpCapital}, {company.legalName} presents itself as a Singapore-based contractor
					focused on delivering defined work packages within major residential, public-housing and
					infrastructure developments.
				</p>
			</div>
			<div class="logo-panel">
				<Image src={lockup} alt={`${company.legalName} logo`} width={320} densities={[1, 2]} />
			</div>
		</div>
	</section>

	<section class="section section--surface" aria-labelledby="snapshot-title">
		<div class="container snapshot-grid">
			<div>
				<h2 id="snapshot-title">Corporate snapshot</h2>
				<p class="muted measure">
					Corporate particulars as supplied in the company's 2026 project portfolio.
				</p>
			</div>
			<dl class="facts">
				<div><dt>Legal name</dt><dd>{company.legalName}</dd></div>
				<div><dt>Entity type</dt><dd>{company.entityType}</dd></div>
				<div><dt>UEN</dt><dd>{company.uen}</dd></div>
				<div><dt>Incorporation date</dt><dd>{company.incorporated}</dd></div>
				<div><dt>Current status</dt><dd>{company.status}</dd></div>
				<div><dt>Paid-up capital</dt><dd>{company.paidUpCapital}</dd></div>
				<div><dt>Registered office</dt><dd>{fullAddress}</dd></div>
				<div>
					<dt>Business activities</dt>
					<dd>
						General Contractors (Building Construction including Major Upgrading Works): principal and
						secondary activity
					</dd>
				</div>
			</dl>
		</div>
	</section>

	<section class="section" aria-labelledby="approach-title">
		<div class="container approach-grid">
			<div class="measure">
				<h2 id="approach-title">How the company works</h2>
				<p>
					{company.legalName} combines its general contracting activity with practical site-based delivery
					of specialist construction packages. The selected projects place the company within complex
					development environments where steelwork, access structures, railings, barriers and temporary
					works must be coordinated with broader building and civil programmes.
				</p>
				<p>
					The portfolio includes public housing developments with high-rise residential blocks and communal
					facilities, as well as infrastructure works associated with the North-South Corridor.
				</p>
			</div>
			<div class="audience">
				<h3>Who this information is for</h3>
				<p>
					Clients, main contractors, consultants and procurement teams reviewing the company's corporate
					particulars, business activity and selected project capabilities during tendering,
					prequalification and business development discussions.
				</p>
				<p class="note">
					The project pages present selected portfolio records. Periods and values are as stated in the
					portfolio.
				</p>
				<a class="text-link" href="/projects/">View selected projects <Icon name="arrow-right" size={18} /></a>
			</div>
		</div>
	</section>

	<ContactCTA />
</BaseLayout>

<style>
	.profile-grid,
	.snapshot-grid,
	.approach-grid {
		display: grid;
		gap: var(--space-2xl);
	}

	@media (min-width: 1024px) {
		.profile-grid {
			grid-template-columns: 1.5fr 1fr;
			align-items: center;
		}

		.snapshot-grid {
			grid-template-columns: 1fr 2fr;
		}

		.approach-grid {
			grid-template-columns: 1.5fr 1fr;
		}
	}

	.logo-panel {
		display: flex;
		justify-content: center;
		padding: var(--space-xl);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	.audience {
		padding: var(--space-lg);
		border-top: 4px solid var(--color-teal);
		background: var(--color-surface);
	}
</style>
