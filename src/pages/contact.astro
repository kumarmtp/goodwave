---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { company, mapUrl } from '../data/company';
---

<BaseLayout
	title="Contact"
	description="Contact GOOD WAVE E&C PTE. LTD. by phone on +65 96644506. Registered office: 740 Pasir Ris Street 71, #02-55, Singapore 510740."
>
	<PageHeader
		eyebrow="Contact"
		title="Contact GOOD WAVE E&C"
		intro="For tender submissions, prequalification and business development discussions, please contact the company by phone."
	/>

	<section class="section" aria-label="Contact details">
		<div class="container contact-grid">
			<article class="contact-card">
				<span class="icon"><Icon name="phone" size={24} /></span>
				<h2>Phone</h2>
				<p class="value"><a href={company.phone.href}>{company.phone.display}</a></p>
				<a class="btn btn--primary" href={company.phone.href}>
					<Icon name="phone" size={18} /> Call now
				</a>
			</article>

			<article class="contact-card">
				<span class="icon"><Icon name="map-pin" size={24} /></span>
				<h2>Registered office</h2>
				<address class="value">
					{company.legalName}<br />
					{company.address.street}<br />
					Singapore {company.address.postalCode}
				</address>
				<a class="btn btn--secondary" href={mapUrl} target="_blank" rel="noopener noreferrer">
					Open in Google Maps <Icon name="external" size={18} />
					<span class="visually-hidden">(opens in a new tab)</span>
				</a>
			</article>
		</div>
	</section>

	<section class="section section--surface" aria-labelledby="company-details-title">
		<div class="container narrow">
			<h2 id="company-details-title">Company details</h2>
			<dl class="facts">
				<div><dt>Legal name</dt><dd>{company.legalName}</dd></div>
				<div><dt>UEN</dt><dd>{company.uen}</dd></div>
				<div><dt>Company status</dt><dd>{company.status} · Private Company Limited by Shares</dd></div>
			</dl>
			<p class="note">
				The company portfolio does not list an email address or online enquiry form, so phone is the
				published contact channel.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.contact-grid {
		display: grid;
		gap: var(--space-lg);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
	}

	.contact-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-sm);
		padding: var(--space-xl);
		border: 1px solid var(--color-border);
		border-top: 4px solid var(--color-brand);
		border-radius: var(--radius-md);
	}

	.icon {
		display: inline-flex;
		padding: var(--space-sm);
		border-radius: var(--radius-md);
		background: var(--color-tint);
		color: var(--color-brand);
	}

	.contact-card h2 {
		font-size: var(--text-xl);
		margin: var(--space-sm) 0 0;
	}

	.value {
		font-size: var(--text-lg);
		font-style: normal;
		margin: 0 0 var(--space-md);
		flex: 1;
	}

	.value a {
		font-family: var(--font-heading-stack);
		font-weight: 600;
		font-size: var(--text-2xl);
		text-decoration: none;
	}

	.narrow {
		max-width: calc(820px + 2 * var(--gutter));
	}
</style>
