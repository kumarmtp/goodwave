---
import { company } from '../data/company';
import Icon from './Icon.astro';

interface Props {
	title?: string;
	text?: string;
}

const {
	title = 'Discuss a work package',
	text = 'For tender submissions, prequalification and business development discussions, contact GOOD WAVE E&C PTE. LTD. by phone.',
} = Astro.props;
---

<section class="cta on-dark" aria-labelledby="cta-title">
	<div class="container cta-inner">
		<div>
			<h2 id="cta-title">{title}</h2>
			<p>{text}</p>
		</div>
		<div class="btn-row">
			<a class="btn btn--light" href={company.phone.href}>
				<Icon name="phone" size={18} />
				Call {company.phone.display}
			</a>
			<a class="btn btn--outline-light" href="/contact/">Contact details</a>
		</div>
	</div>
</section>

<style>
	.cta {
		background: var(--color-brand);
		color: var(--color-tint);
		padding-block: var(--space-2xl);
		border-top: 4px solid var(--color-ochre);
	}

	.cta-inner {
		display: grid;
		gap: var(--space-lg);
		align-items: center;
	}

	@media (min-width: 1024px) {
		.cta-inner {
			grid-template-columns: 1.4fr auto;
			gap: var(--space-2xl);
		}
	}

	h2 {
		color: var(--color-on-brand);
		margin-bottom: var(--space-sm);
	}

	p {
		margin: 0;
		max-width: 60ch;
	}
</style>
